---
// src/components/PackageTemplate.astro
import Layout from '@layouts/Layout.astro';
import SuggestedRoutes from './SuggestedRoutes.astro';
import TourGallery from './TourGallery.astro';
import ItineraryHero from './ItineraryHero';
import ItineraryIntro from './ItineraryIntro';
import ItinerarySchedule from './ItinerarySchedule';
import LogisticsCard from './LogisticsCard';
import ItineraryBooking from './ItineraryBooking';


interface Props {
  lang: 'es' | 'en';
  data: any;
}

const { lang, data } = Astro.props;
const t = data[lang];
const formatTitle = (str: string) => {
  if (!str) return '';
  return str.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ');
};

const pageTitle = `${formatTitle(t.hero.titleMain)} | Alpine Treks Perú`;
---

<Layout 
  title={pageTitle} 
  description={t.hero.description || t.intro.description}
  keywords={`${t.hero.titleMain.toLowerCase()}, trekking peru, cordillera blanca, huayhuash, expedicion tecnica, alpine treks`}
  image={t.hero.backgroundImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TouristTrip",
      "name": t.hero.titleMain,
      "description": t.hero.description || t.intro.description,
      "image": `https://alpinetreksperu.com${t.hero.backgroundImage}`,
      "provider": {
        "@type": "TravelAgency",
        "name": "ALPINE TREKS PERÚ"
      }
    })} />
  </Fragment>

  <ItineraryHero
    lang={lang}
    titleTop={t.hero.titleTop}
    titleMain={t.hero.titleMain}
    backgroundImage={t.hero.backgroundImage}
    duration={t.hero.duration}
    price={t.hero.price}
    difficulty={t.hero.difficulty}
    difficultyLevel={t.hero.difficultyLevel}
  />

  <ItineraryIntro
    lang={lang}
    code={t.intro.code}
    titlePrefix={t.intro.titlePrefix}
    titleAccent={t.intro.titleAccent}
    description={t.intro.description}
    image={t.intro.image}
    lat={t.intro.lat}
    lon={t.intro.lon}
    specs={t.intro.specs}
  <section class="details-section bg-[#fafafa] py-24 border-t border-slate-200">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-8">
          <ItinerarySchedule 
            lang={lang}
            days={t.itinerary.map((item: any) => ({
              day: item.day,
              title: item.title,
              description: item.content,
              stats: item.stats
            }))}
            title={t.itineraryTitle}
            subtitle={t.itinerarySubtitle}
          />
        </div>

        <aside class="lg:col-span-4 sticky top-24 h-fit">
          <div class="flex flex-col gap-10">
            <LogisticsCard
              title={t.includesTitle}
              items={t.includes}
              refCode="SRV-INC"
              variant="primary"
            />

            <LogisticsCard
              title={t.equipmentTitle}
              items={t.equipment}
              refCode="EQP-TCN"
              variant="secondary"
            />

            {t.excludes && (
              <LogisticsCard
                title={lang === 'es' ? 'No Incluye' : 'Not Included'}
                items={t.excludes}
                refCode="SRV-EXC"
                variant="secondary"
              />
            )}

            <ItineraryBooking
              client:visible
              lang={lang}
              tourName={t.hero.titleMain}
            />
          </div>
        </aside>
      </div>
    </div>
  </section>

  {t.gallery && (
    <TourGallery 
      lang={lang}
      tourName={t.hero.titleMain}
      images={t.gallery} 
    />
  )}

  <SuggestedRoutes lang={lang} currentId={data.id} />
</Layout>

<style>
  .details-section {
    position: relative;
    z-index: 10;
  }
</style>
