---
import Layout from '@layouts/Layout.astro';
import Slider from './Slider';
import Institutional from './Institutional';
import WorkArea from './WorkArea';
import TeamSection from './TeamSection';
import Gastronomy from './Gastronomy';
import Logistics from './Logistics';
import EthicsBento from './EthicsBento';
import SuggestedRoutes from './SuggestedRoutes';
import { useTranslations } from '@i18n/utils';

interface Props {
  lang: 'es' | 'en';
  data: any;
}

const { lang, data } = Astro.props;
const t = useTranslations(lang);
---

<Layout 
	title={data.title} 
	description={data.description}
>
	<Slider client:idle lang={lang} slides={data.slides} buttonLabel={t('slider.btn')} />
	<Institutional data={data.institutional} />
	<WorkArea data={data.workArea} />
	<TeamSection data={data.team} />
	<Gastronomy data={data.gastronomy} />
	<Logistics client:visible data={data.logistics} />
	<EthicsBento client:visible data={data.ethics} />
	<SuggestedRoutes client:visible lang={lang} />
</Layout>
