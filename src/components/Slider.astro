---
interface Slide {
  src: string;
  pretitle: string;
  title: string;
  subtitle: string;
}

interface Props {
  lang: 'es' | 'en';
  slides: Slide[];
  buttonLabel: string;
}

const { lang, slides, buttonLabel } = Astro.props;
---

<div id="hero-slider" class="relative w-full h-[100vh] min-h-[500px] md:min-h-[600px] overflow-hidden bg-black">
  <div class="absolute inset-0 z-10">
    {slides.map((slide, index) => (
      <div
        class={`slider-slide absolute inset-0 transition-all duration-1000 ease-in-out ${
          index === 0 ? 'opacity-100 visible z-20' : 'opacity-0 invisible z-10'
        }`}
        data-index={index}
      >
        <!-- Image with Ken Burns Effect -->
        <div class="absolute inset-0 overflow-hidden">
          <div
            class="w-full h-full"
            style={{ 
              backgroundImage: `url(${slide.src})`,
              backgroundSize: 'cover',
              backgroundPosition: 'center',
              backgroundRepeat: 'no-repeat'
            }}
          />
        </div>

        <!-- Cinematic Overlays -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent z-20 md:block hidden"></div>
        <div class="absolute inset-0 bg-black/50 z-20 md:hidden block"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-20"></div>

        <!-- Content Container -->
        <div class="absolute inset-0 z-30 flex items-center px-6 sm:px-10 md:px-[8%] pt-[10vh] md:pt-[12vh]">
          <div class="max-w-[800px] w-full text-center md:text-left mx-auto md:mx-0">
            <div class={`slide-content transition-all duration-700 delay-200 transform ${index === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'}`}>
              <span class="inline-flex items-center gap-3 md:gap-4 text-brand-blue text-[0.7rem] sm:text-[0.8rem] md:text-[0.9rem] font-bold uppercase tracking-[0.2em] mb-3 md:mb-4">
                <span class="hidden md:block w-8 md:w-12 h-[2px] bg-brand-blue"></span>
                {slide.pretitle}
              </span>
            </div>
            
            <div class={`slide-content transition-all duration-700 delay-400 transform ${index === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'}`}>
              <h1 class="text-white text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black uppercase leading-[1.1] mb-3 md:mb-5 drop-shadow-2xl">
                {slide.title}
              </h1>
            </div>

            <div class={`slide-content transition-all duration-700 delay-600 transform ${index === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'}`}>
              <p class="text-white/90 text-xs sm:text-base leading-relaxed max-w-[550px] mb-6 md:mb-10 font-medium drop-shadow-lg mx-auto md:mx-0">
                {slide.subtitle}
              </p>
            </div>

            <div class={`slide-content transition-all duration-700 delay-800 transform ${index === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'}`}>
              <a
                href={lang === 'es' ? '/es/tours' : '/tours'}
                class="inline-flex items-center gap-3 bg-brand-red hover:bg-brand-dark text-white px-5 py-3 sm:px-6 sm:py-3.5 rounded-lg font-black text-[0.75rem] sm:text-[0.8rem] uppercase transition-all duration-300 shadow-xl hover:-translate-y-1 hover:shadow-brand-red/30"
              >
                {buttonLabel}
                <svg class="transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Navigation Arrows - Hidden on small mobile -->
  <div class="absolute inset-y-0 left-4 lg:left-10 hidden sm:flex items-center z-40 pointer-events-none">
    <button
      id="slider-prev"
      class="w-10 h-10 md:w-14 md:h-14 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white flex items-center justify-center hover:bg-white hover:text-black transition-all duration-300 pointer-events-auto group"
      aria-label={lang === 'es' ? "Diapositiva anterior" : "Previous slide"}
    >
      <svg class="transition-transform group-hover:scale-110" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>
  </div>
  <div class="absolute inset-y-0 right-4 lg:right-10 hidden sm:flex items-center z-40 pointer-events-none">
    <button
      id="slider-next"
      class="w-10 h-10 md:w-14 md:h-14 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white flex items-center justify-center hover:bg-white hover:text-black transition-all duration-300 pointer-events-auto group"
      aria-label={lang === 'es' ? "Siguiente diapositiva" : "Next slide"}
    >
      <svg class="transition-transform group-hover:scale-110" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>

  <!-- Progress Bars - Centered on mobile -->
  <div class="absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 md:left-[8%] md:translate-x-0 w-[80%] sm:w-[300px] md:w-[400px] flex gap-2 md:gap-3 z-40">
    {slides.map((_, index) => (
      <button
        class="slider-dot flex-1 h-1 bg-white/20 rounded-full overflow-hidden relative group"
        data-index={index}
        aria-label={lang === 'es' ? `Ir a diapositiva ${index + 1}` : `Go to slide ${index + 1}`}
      >
        <div
          class={`slider-progress absolute inset-0 bg-brand-blue rounded-full transition-all duration-[6000ms] linear ${
            index === 0 ? 'w-full' : 'w-0 transition-none'
          }`}
        ></div>
      </button>
    ))}
  </div>
</div>

<script>
  function setupSlider() {
    const sliderContainer = document.getElementById('hero-slider');
    if (!sliderContainer) return;

    const slides = document.querySelectorAll('.slider-slide');
    const dots = document.querySelectorAll('.slider-dot');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    
    let currentIndex = 0;
    let isTransitioning = false;
    let timer: number | null = null;
    const slideDuration = 6000;

    function updateDOM(newIndex: number) {
      // Update Slides
      slides.forEach((slide, index) => {
        const contents = slide.querySelectorAll('.slide-content');
        if (index === newIndex) {
          slide.classList.remove('opacity-0', 'invisible', 'z-10');
          slide.classList.add('opacity-100', 'visible', 'z-20');
          contents.forEach(content => {
            content.classList.remove('opacity-0', 'translate-y-8');
            content.classList.add('opacity-100', 'translate-y-0');
          });
        } else {
          slide.classList.add('opacity-0', 'invisible', 'z-10');
          slide.classList.remove('opacity-100', 'visible', 'z-20');
          contents.forEach(content => {
            content.classList.add('opacity-0', 'translate-y-8');
            content.classList.remove('opacity-100', 'translate-y-0');
          });
        }
      });

      // Update Progress Bars
      dots.forEach((dot, index) => {
        const progress = dot.querySelector('.slider-progress');
        if (index === newIndex) {
          // Force reflow to restart animation
          if (progress) {
            progress.classList.remove('transition-all', 'duration-[6000ms]', 'linear', 'w-full');
            progress.classList.add('w-0', 'transition-none');
            void (progress as HTMLElement).offsetWidth; 
            progress.classList.remove('w-0', 'transition-none');
            progress.classList.add('transition-all', 'duration-[6000ms]', 'linear', 'w-full');
          }
        } else {
          if (progress) {
            progress.classList.remove('w-full', 'transition-all', 'duration-[6000ms]', 'linear');
            progress.classList.add('w-0', 'transition-none');
          }
        }
      });
    }

    function goToSlide(index: number) {
      if (isTransitioning || index === currentIndex) return;
      isTransitioning = true;
      currentIndex = index;
      updateDOM(currentIndex);
      setTimeout(() => {
        isTransitioning = false;
      }, 1000);
      resetAutoPlay();
    }

    function nextSlide() {
      if (isTransitioning) return;
      const nextIndex = (currentIndex + 1) % slides.length;
      goToSlide(nextIndex);
    }

    function prevSlide() {
      if (isTransitioning) return;
      const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
      goToSlide(prevIndex);
    }

    function resetAutoPlay() {
      if (timer) clearInterval(timer);
      timer = window.setInterval(nextSlide, slideDuration);
    }

    // Event Listeners
    prevBtn?.addEventListener('click', prevSlide);
    nextBtn?.addEventListener('click', nextSlide);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    // Initialize AutoPlay
    resetAutoPlay();
    
    // Initial DOM update for progress bar animation
    updateDOM(0);
  }

  // Support for Astro View Transitions if enabled
  document.addEventListener('astro:page-load', setupSlider);
  // Initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSlider);
  } else {
    setupSlider();
  }
</script>
