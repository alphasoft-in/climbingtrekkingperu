---
import Layout from '@layouts/Layout.astro';
import TourCard from './TourCard';
import SuggestedRoutes from './SuggestedRoutes';
import PageHero from './PageHero';
import { getRelativeLocaleUrl } from '@i18n/utils';

interface Props {
  lang: 'es' | 'en';
  metadata: any;
  programs: any[];
}

const { lang, metadata, programs } = Astro.props;
const formatTitle = (str: string) => {
  if (!str) return '';
  return str.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ');
};

const pageTitle = `${formatTitle(metadata[lang].titleMain)} - Alpine Treks Perú`;
---

<Layout 
  title={pageTitle} 
  description={metadata[lang].description}
  keywords={`${metadata[lang].titleMain.toLowerCase()}, trekking peru, expeditions, adventure huaraz`}
  image={metadata[lang].backgroundImage}
>
  <PageHero 
    titleTop={metadata[lang].titleTop}
    titleMain={metadata[lang].titleMain}
    backgroundImage={metadata[lang].backgroundImage}
    techData={metadata[lang].techData}
  />

  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
        {programs.map((prog) => (
          <TourCard 
            id={prog.id}
            title={prog.title[lang]}
            description={prog.description[lang]}
            image={prog.image}
            duration={prog.duration[lang]}
            difficulty={prog.difficulty[lang]}
            difficultyLevel={prog.difficultyLevel}
            href={getRelativeLocaleUrl(lang, prog.path)}
            prefix={prog.prefix}
            category={prog.category[lang]}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>

  <SuggestedRoutes client:visible lang={lang} />
</Layout>
