---
import Footer from "@components/Footer.tsx";
import Navbar from "@components/Navbar.tsx";
import FloatingWhatsApp from "@components/FloatingWhatsApp.tsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
}

const {
	title = "Alpine Treks Peru - Top Travel & Trekking Agency in Peru | Huaraz & Andes",
	description = "Leading local travel agency in Peru. Specialists in technical mountain expeditions and trekking in Cordillera Blanca and Huayhuash. UIAGM certified guides.",
	keywords = "travel agency peru, trekking in peru, huaraz mountaineering, cordillera blanca trek, huayhuash circuit, peru expeditions, alpine treks peru",
	image = "/og-image.avif",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const routeName = currentPath
	.replace(/^\/es(\/|$)/, "$1")
	.replace(/^\//, "")
	.split("?")[0]
	.replace(/\/$/, "");

let enUrl = `/${routeName}`;
let esUrl = `/es/${routeName}`;

// Handle localized page name mapping
const mappings: Record<string, { es: string; en: string }> = {
	nosotros: { es: "/es/nosotros", en: "/about" },
	about: { es: "/es/nosotros", en: "/about" },
};

if (mappings[routeName]) {
	esUrl = mappings[routeName].es;
	enUrl = mappings[routeName].en;
}

const isToursRoute = routeName === "tours" || routeName.startsWith("tours/");

// List of routes that should highlight the "Destinations" menu (specifically Peru)
const peruSpecificRoutes = [
	"trekking/arequipa",
	"tours/ica-paracas",
	"tours/iquitos-amazonas",
	"tours/selva-tambopata",
	"tours/lima-city",
	"tours/lima-pachacamac",
	"tours/maravillas-peru-17d",
	"tours/laguna-paron",
	"tours/laguna-llanganuco",
	"tours/trekking-69",
	"tours/laguna-rocotuyoc",
	"tours/pastoruri",
	"tours/chavin-huantar",
	"tours/chacas-conchucos",
	"tours/trekking-churup",
	"tours/peru-bolivia-confort",
	"trekking/cusco/choquequirao",
	"trekking/cusco/camino-inca",
	"trekking/cusco/ausangate",
	"trekking/cusco/lares",
];

const isDestinationsActive =
	["peru", "bolivia", "ecuador", "chile", "argentina"].some(
		(c) => routeName === c || routeName.startsWith(c + "/"),
	) ||
	peruSpecificRoutes.some(
		(r) => routeName === r || routeName.startsWith(r + "/"),
	);

const isToursActive =
	routeName.startsWith("tours") && !peruSpecificRoutes.includes(routeName);

const isTrekkingActive =
	!isToursRoute &&
	((routeName.startsWith("trekking") &&
		!routeName.startsWith("trekking/arequipa") &&
		!routeName.startsWith("trekking/cusco/choquequirao") &&
		!routeName.startsWith("trekking/cusco/camino-inca") &&
		!routeName.startsWith("trekking/cusco/ausangate") &&
		!routeName.startsWith("trekking/cusco/lares")) ||
		routeName.includes("huayhuash") ||
		routeName.includes("blanca"));

const navLabels = {
	home: t("nav.home"),
	about: t("nav.about"),
	trekking: t("nav.trekking"),
	huayhuash: t("nav.huayhuash"),
	blanca: t("nav.blanca"),
	cusco: t("nav.cusco"),
	climbing: t("nav.climbing"),
	destinations: t("nav.destinations"),
	peru: t("nav.peru"),
	bolivia: t("nav.bolivia"),
	ecuador: t("nav.ecuador"),
	chile: t("nav.chile"),
	argentina: t("nav.argentina"),
	tours: t("nav.tours"),
	gallery: t("nav.gallery"),
	contact: t("nav.contact"),
};

const footerLabels = {
	brandName: t("footer.brandName"),
	brandDesc: t("footer.brandDesc"),
	navTitle: t("footer.navTitle"),
	navHome: t("footer.navHome"),
	navTours: t("footer.navTours"),
	navAbout: t("footer.navAbout"),
	navContact: t("footer.navContact"),
	legalTitle: t("footer.legalTitle"),
	legalEthics: t("footer.legalEthics"),
	legalTerms: t("footer.legalTerms"),
	legalPrivacy: t("footer.legalPrivacy"),
	legalEsnna: t("footer.legalEsnna"),
	legalCert: t("footer.legalCert"),
	contactTitle: t("footer.contactTitle"),
	contactHq: t("footer.contactHq"),
	copy: t("footer.copy"),
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" />
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link
			rel="canonical"
			href={new URL(
				Astro.url.pathname,
				Astro.site || "https://alpinetreksperu.com",
			)}
		/>

		<!-- Multilingual SEO -->
		<link
			rel="alternate"
			hreflang="es"
			href={`https://alpinetreksperu.com${esUrl}`}
		/>
		<link
			rel="alternate"
			hreflang="en"
			href={`https://alpinetreksperu.com${enUrl}`}
		/>
		<link
			rel="alternate"
			hreflang="x-default"
			href={`https://alpinetreksperu.com${esUrl}`}
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600;700;800&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600;700;800&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600;700;800&display=swap"
			/>
		</noscript>

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "TravelAgency",
				name: "Alpine Treks Perú",
				image: "https://alpinetreksperu.com/logo.png",
				description: description,
				url: "https://alpinetreksperu.com",
				telephone: "+51962421830",
				address: {
					"@type": "PostalAddress",
					streetAddress: "Huaraz",
					addressLocality: "Huaraz",
					addressRegion: "Ancash",
					addressCountry: "PE",
				},
			})}
		/>
		<slot name="head" />
	</head>
	<body>
		<Navbar
			client:load
			lang={lang as "es" | "en"}
			labels={navLabels}
			esUrl={esUrl}
			enUrl={enUrl}
			currentPath={currentPath}
			routeName={routeName}
			isTrekkingActive={isTrekkingActive}
			isDestinationsActive={isDestinationsActive}
			isToursActive={isToursActive}
		/>

		<main>
			<slot />
		</main>

		<Footer lang={lang as "es" | "en"} labels={footerLabels} />

		<FloatingWhatsApp />
	</body>
</html>
